{
  "name": "remain-remotion",
  "version": "1.0.0",
  "description": "Skeleton Remotion cho kinetic-typography 'Remain' — thử nghiệm song song với app vanilla (không thay thế).",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Remain-16x9 out/remain-16x9.mp4 --concurrency=4",
    "render:vertical": "remotion render Remain-9x16 out/remain-9x16.mp4 --concurrency=4",
    "render:hw": "remotion render Remain-16x9 out/remain-16x9.mp4 --concurrency=4 --codec=h264 --hardware-acceleration=if-possible",
    "render:yt": "remotion render Remain-16x9 out/remain-yt-1080p.mp4 --codec=h264 --crf=16 --concurrency=4",
    "upgrade": "remotion upgrade",
    "studio:build": "vite build studio",
    "studio": "node studio/server.mjs",
    "studio:check": "tsc --noEmit && node --test studio/test/*.test.mjs",
    "studio:e2e": "node studio/test/e2e.mjs",
    "studio:e2e:workspace": "node studio/test/workspace-e2e.mjs",
    "studio:progress": "node studio/test/progress-live.mjs",
    "studio:progress:ui": "node studio/test/progress-ui.mjs",
    "studio:e2e:media": "node studio/test/media-e2e.mjs",
    "studio:e2e:session": "node studio/test/session-e2e.mjs",
    "studio:dev": "node studio/server.mjs --dev"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@remotion/bundler": "4.0.484",
    "@remotion/cli": "4.0.484",
    "@remotion/google-fonts": "4.0.484",
    "@remotion/media": "4.0.484",
    "@remotion/media-utils": "4.0.484",
    "@remotion/player": "4.0.484",
    "@remotion/renderer": "4.0.484",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.484",
    "tailwind-merge": "3.7.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "^6.2.8",
    "playwright-core": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5.5.0",
    "vite": "7.3.8"
  }
}
