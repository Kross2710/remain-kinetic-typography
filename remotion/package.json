{
  "name": "remain-remotion",
  "version": "1.0.0",
  "description": "Skeleton Remotion cho kinetic-typography 'Remain' — thử nghiệm song song với app vanilla (không thay thế).",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Remain-16x9 out/remain-16x9.mp4 --concurrency=4",
    "render:vertical": "remotion render Remain-9x16 out/remain-9x16.mp4 --concurrency=4",
    "render:hw": "remotion render Remain-16x9 out/remain-16x9.mp4 --concurrency=4 --codec=h264 --hardware-acceleration=if-possible",
    "render:yt": "remotion render Remain-16x9 out/remain-yt-1080p.mp4 --codec=h264 --crf=16 --concurrency=4",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "@remotion/google-fonts": "4.0.484",
    "@remotion/media": "4.0.484",
    "@remotion/media-utils": "4.0.484",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.484",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.5.0"
  }
}
