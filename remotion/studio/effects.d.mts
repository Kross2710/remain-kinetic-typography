export type Preset = 'classic'|'aurora'|'whisper'|'web-match';
export type Font = 'serif'|'sans'|'mono';
export type TextMotionId = 'enter'|'wipe'|'ink';
export type MotionId = TextMotionId|'flow';
export type MotionSettings = Partial<Record<MotionId,boolean>>;
export type LineMotionSettings = Partial<Record<TextMotionId,boolean>>;
export type Effect = {preset:Preset;font:Font;size:number;color:string;accent:string;entry:number;stagger:number;motion?:MotionSettings};
export type SectionKind = 'intro'|'verse'|'pre-chorus'|'chorus'|'bridge'|'outro';
export type SongSection = {start:number;kind:SectionKind};
export const PRESETS:Readonly<Record<Preset,Readonly<Effect>>>;
export const PRESET_LABELS:Readonly<Record<Preset,string>>;
export const FONT_STACKS:Readonly<Record<Font,string>>;
export const SECTION_LABELS:Readonly<Record<SectionKind,string>>;
export const MAX_SECTIONS:number;
export const MOTION_LIBRARY:Readonly<Record<MotionId,Readonly<{label:string;scope:'text'|'project'}>>>;
export function validateMotion(value:unknown,scope?:'project'|'line'):MotionSettings;
export function resolveMotion(project?:Effect,local?:LineMotionSettings):Record<MotionId,boolean>;
export function validateEffect(value:unknown):Effect;
export function validateSections(value:unknown,maxSeconds:number):SongSection[];
